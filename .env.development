# LanguageTool server used for grammar checking. Grammar checking is
# unavailable in the app when unset.
# Defaults to the free public API (rate limited, text is sent to
# languagetool.org). For production or privacy, self-host with:
#   docker run -d --name languagetool -p 8010:8010 -e Java_Xms=256m -e Java_Xmx=512m erikvl87/languagetool
# and point this to http://127.0.0.1:8010 instead.
LANGUAGE_TOOL_URL=http://127.0.0.1:8010
